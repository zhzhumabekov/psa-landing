# Образец настроек сервера. Файл .env рядом создаёт сам deploy/install.sh —
# вручную этот образец нужен, только чтобы поменять что-то после установки.
# .env не коммитить: в нём секретный ключ.

# Адрес для Caddy: домены через запятую — HTTPS-сертификат выпускается сам;
# «:80» — сайт по IP без HTTPS.
SITE_ADDRESS=psa.kz, www.psa.kz

# Длинная случайная строка (install.sh генерирует её сам).
DJANGO_SECRET_KEY=замените-на-длинную-случайную-строку

# Имена, по которым открывается сайт (через запятую, без пробелов).
DJANGO_ALLOWED_HOSTS=psa.kz,www.psa.kz
DJANGO_CSRF_TRUSTED_ORIGINS=https://psa.kz,https://www.psa.kz

# 1 — сайт по HTTPS (защищённые cookie), 0 — по http (адрес-IP без сертификата).
DJANGO_HTTPS=1

# Полный адрес сайта для ссылок из админки (письма и т.п.).
WAGTAILADMIN_BASE_URL=https://psa.kz

# Число процессов gunicorn (примерно 2 × ядер процессора + 1; для SQLite больше 4 не нужно).
GUNICORN_WORKERS=3

# Почта (SMTP), получатели формы «Контакты», режим обслуживания — в админке сайта:
# «Настройки» → «Почта (SMTP)», «Форма «Контакты»», «Сайт».
