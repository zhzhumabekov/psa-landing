# Caddy перед сайтом: HTTPS (сертификат Let's Encrypt выпускается и продлевается сам,
# если SITE_ADDRESS — домен), статика и загруженные файлы, всё остальное — Django (web).
# SITE_ADDRESS задаётся в .env: «psa.kz, www.psa.kz» — домены с HTTPS, «:80» — по IP без HTTPS.
{$SITE_ADDRESS} {
	encode zstd gzip

	handle_path /static/* {
		root * /srv/static
		header Cache-Control "public, max-age=3600"
		file_server
	}

	# Документы библиотеки Wagtail отдаёт Django по адресу /files/ (с учётом прав
	# доступа к коллекциям) — напрямую из media/documents/ не раздаём.
	handle /media/documents/* {
		respond 404
	}
	handle_path /media/* {
		root * /srv/data/media
		header Cache-Control "public, max-age=86400"
		file_server
	}

	# Загрузка резервной копии в админке — копия с файлами бывает в сотни МБ.
	handle /admin/backups/upload/ {
		request_body {
			max_size 2GB
		}
		reverse_proxy web:8000
	}

	handle {
		request_body {
			max_size 30MB
		}
		reverse_proxy web:8000
	}
}
